# Duplicate this to .env.local for development.

# --- Required for the article admin & DB-backed pages ---

# Vercel Marketplace -> Neon Postgres -> reveals this
DATABASE_URL='postgresql://...'

# Vercel Marketplace -> Clerk -> reveals these
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY='pk_...'
CLERK_SECRET_KEY='sk_...'

# Comma-separated email allowlist for /admin access
ADMIN_EMAILS='you@example.com'

# --- Optional ---
APP_URL='http://localhost:3000'
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION_ID=
BING_SITE_VERIFICATION_ID=
BAIDU_SITE_VERIFICATION_ID=
YANDEX_SITE_VERIFICATION_ID=
