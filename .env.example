# Duplicate this to .env.local for development.

# --- Required for the article admin & DB-backed pages ---

# Use an absolute path. Initialize the database with bun run db:migrate.
SQLITE_PATH='/absolute/path/to/website.sqlite'

# Keep the current Clerk instance for the website.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY='pk_...'
CLERK_SECRET_KEY='sk_...'

# Comma-separated email allowlist for /admin access (also used to gate /admin/tokens)
ADMIN_EMAILS='you@example.com'

# --- Optional ---
APP_URL='http://localhost:3000'
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION_ID=
BING_SITE_VERIFICATION_ID=
BAIDU_SITE_VERIFICATION_ID=
YANDEX_SITE_VERIFICATION_ID=
CRON_SECRET=
NEXT_PUBLIC_TRY_SITE_URL='https://try.uniclipboard.app'
DOCS_ORIGIN='https://docs.uniclipboard.app'
# Set to 1 only during maintenance. Restart after changing this value.
WEBSITE_READ_ONLY=0
